---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectHeader from '../../components/ProjectHeader.astro';
import DemoSlot from '../../components/DemoSlot.astro';
import ProjectNav from '../../components/ProjectNav.astro';
import { sortByOrder } from '../../lib/projects';

export async function getStaticPaths() {
  const all = sortByOrder(await getCollection('projects'));
  return all.map((project, i) => {
    const prev = all[(i - 1 + all.length) % all.length];
    const next = all[(i + 1) % all.length];
    return {
      params: { slug: project.id },
      props: { project, prev: { id: prev.id, name: prev.data.name }, next: { id: next.id, name: next.data.name } },
    };
  });
}

interface Props {
  project: CollectionEntry<'projects'>;
  prev: { id: string; name: string };
  next: { id: string; name: string };
}
const { project, prev, next } = Astro.props;
const { Content } = await render(project);
---
<Base title={`${project.data.name} | Obaseki`} description={project.data.summary} image={`/images/projects/${project.id}/og.jpg`}>
  <nav class="pbar" aria-label="Project navigation">
    <div class="wrap pbar-in">
      <a href="/#projects" class="pbar-back">← All projects</a>
      <span class="pbar-name">{project.data.name}</span>
      <a href={`/projects/${next.id}`} class="pbar-next" aria-label={`Next project: ${next.name}`}>Next →</a>
    </div>
  </nav>
  <div class="wrap">
    <ProjectHeader project={project} />
    <section class="ui" aria-label="Project UI"><DemoSlot project={project} /></section>
    <article class="prose"><Content /></article>
    <ProjectNav prev={prev} next={next} />
  </div>
</Base>
<style>
  .pbar { position: sticky; top: 64px; z-index: 45; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--br); }
  .pbar-in { display: flex; align-items: center; gap: 12px; height: 48px; }
  .pbar a { text-decoration: none; font-weight: 700; font-size: 15px; padding: 8px 12px; margin: 0 -12px; border-radius: 8px; }
  .pbar a:hover { color: var(--acc); }
  .pbar-back { color: var(--ink); }
  .pbar-name { margin-inline: auto; font-weight: 800; font-size: 15px; color: var(--dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .pbar-next { color: var(--dim); }
  .ui { margin: 24px 0 64px; }
  .prose { max-width: 760px; }
  .prose :global(h2) { font-size: 28px; font-weight: 800; letter-spacing: -.02em; margin: 48px 0 14px; }
  .prose :global(h3) { font-size: 20px; font-weight: 800; margin: 28px 0 10px; }
  .prose :global(p), .prose :global(li) { color: var(--dim); font-size: 17.5px; }
  .prose :global(p + p) { margin-top: 14px; }
  .prose :global(ul), .prose :global(ol) { padding-left: 22px; display: grid; gap: 8px; margin: 12px 0; }
  .prose :global(strong) { color: var(--ink); }
  .prose :global(a) { color: var(--acc); }
  .prose :global(code) { font-family: var(--mono); font-size: .88em; background: var(--bg2); padding: 2px 6px; border-radius: 4px; color: var(--ink); }
  .prose :global(figure) { margin: 20px 0; }
</style>
