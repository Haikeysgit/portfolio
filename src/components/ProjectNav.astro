---
interface Props {
  prev: { id: string; name: string };
  next: { id: string; name: string };
}
const { prev, next } = Astro.props;
---
<nav class="pn" aria-label="More projects">
  <a href={`/projects/${prev.id}`}><span class="dir">← Previous</span><span class="n">{prev.name}</span></a>
  <a class="nx" href={`/projects/${next.id}`}><span class="dir">Next →</span><span class="n">{next.name}</span></a>
</nav>
<style>
  .pn { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 72px 0 24px; }
  a { display: flex; flex-direction: column; gap: 4px; padding: 22px; border: 1px solid var(--br); border-radius: 14px; background: var(--bg1); text-decoration: none; }
  a:hover { border-color: var(--acc); }
  .nx { text-align: right; }
  .dir { font-family: var(--mono); font-size: 12.5px; color: var(--dim); text-transform: uppercase; letter-spacing: .08em; }
  .n { font-weight: 800; font-size: 20px; }
  @media (max-width: 600px) { .pn { grid-template-columns: 1fr; } .nx { text-align: left; } }
</style>
