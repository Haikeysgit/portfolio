---
import type { CollectionEntry } from 'astro:content';
import { trackLabel } from '../lib/projects';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const p = project.data;
---
<a class="pcard" href={`/projects/${project.id}`} data-tracks={p.tracks.join(' ')}>
  <div class="shot">
    <img src={p.cover} alt="" loading="lazy" decoding="async" width="1600" height="1000" />
    {p.demo && <span class="demo">Interactive demo</span>}
  </div>
  <div class="body">
    <div class="tracks">{p.tracks.map((t) => <span class="track">{trackLabel(t)}</span>)}</div>
    <h3>{p.name}</h3>
    <p class="sum">{p.summary}</p>
    {p.proof && <p class="proof">{p.proof}</p>}
    {p.status && <p class="status">{p.status}</p>}
    <span class="open">Open project <span aria-hidden="true">→</span></span>
  </div>
</a>
<style>
  .pcard { display: flex; flex-direction: column; text-decoration: none; background: var(--bg1); border: 1px solid var(--br); border-radius: 14px; overflow: hidden; transition: border-color .2s, transform .2s; }
  .pcard:hover { border-color: var(--acc); transform: translateY(-3px); }
  .pcard[hidden] { display: none; }
  .shot { position: relative; aspect-ratio: 16 / 10; background: var(--bg2); overflow: hidden; }
  .shot img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .demo { position: absolute; top: 12px; left: 12px; font-family: var(--mono); font-size: 12px; font-weight: 500; background: var(--acc); color: var(--bg); padding: 4px 10px; border-radius: 4px; }
  .body { display: flex; flex-direction: column; gap: 10px; padding: 22px; flex: 1; }
  .tracks { display: flex; gap: 6px; flex-wrap: wrap; }
  h3 { font-size: 24px; font-weight: 800; letter-spacing: -.02em; line-height: 1.2; }
  .sum { color: var(--dim); font-size: 16px; }
  .proof { font-weight: 700; font-size: 15.5px; border-left: 3px solid var(--acc); padding-left: 12px; }
  .status { font-family: var(--mono); font-size: 12.5px; color: var(--dim); }
  .open { margin-top: auto; padding-top: 8px; font-weight: 700; color: var(--acc); }
</style>
