---
import { writing } from '../data/writing';
import { certificates } from '../data/certificates';
---
<section id="writing" class="wrap section">
  <div class="cols">
    <div>
      <div class="section-head">
        <p class="label">Writing</p>
        <h2 class="h2">Posts about what I build</h2>
      </div>
      <ul class="list">
        {writing.map((w) => (
          <li><a href={w.href} target="_blank" rel="noopener"><span class="meta">{w.date}</span><span class="t">{w.title}</span><span class="arr" aria-hidden="true">↗</span></a></li>
        ))}
      </ul>
    </div>
    <div>
      <div class="section-head">
        <p class="label">Certificates</p>
        <h2 class="h2">Training</h2>
      </div>
      <ul class="list">
        {certificates.map((c) => (
          <li><a href={c.href} target="_blank" rel="noopener"><span class="meta">{c.year} · {c.issuer}</span><span class="t">{c.title}</span><span class="arr" aria-hidden="true">↗</span></a></li>
        ))}
      </ul>
    </div>
  </div>
</section>
<style>
  .cols { display: grid; grid-template-columns: 1.4fr 1fr; gap: 56px; }
  .list { list-style: none; border-top: 1px solid var(--br); }
  .list a { display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'meta arr' 't arr'; gap: 2px 16px; padding: 16px 0; border-bottom: 1px solid var(--br); text-decoration: none; }
  .list a:hover .t { color: var(--acc); }
  .meta { grid-area: meta; font-family: var(--mono); font-size: 12.5px; color: var(--dim); }
  .t { grid-area: t; font-weight: 700; font-size: 17px; }
  .arr { grid-area: arr; align-self: center; color: var(--dim); }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr; gap: 48px; } }
</style>
