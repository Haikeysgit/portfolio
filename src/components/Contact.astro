---
import { SOCIALS, EMAIL } from '../data/socials';
// Web3Forms access key. Public by design: it can only send to the inbox it was created for.
const WEB3FORMS_KEY = '044902a1-2efc-45f2-bb4e-2d82bab2901a';
---
<section id="contact" class="wrap section">
  <div class="box">
    <div>
      <p class="label">Contact</p>
      <h2 class="h2">Get in touch</h2>
      <p class="lead">Open to full-time roles and contract work in web apps, AI agents and blockchain engineering.</p>
      <a class="mail" href="mailto:imisioluwa@obaseki.dev">imisioluwa@obaseki.dev</a>
      <ul class="socs">
        {SOCIALS.filter((s) => s.label !== 'Email').map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.path} /></svg>{s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <form action="https://api.web3forms.com/submit" method="POST" data-contact>
      <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
      <input type="hidden" name="subject" value="New message from obaseki.dev" />
      <input type="hidden" name="from_name" value="obaseki.dev contact form" />
      <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <label>Your email<input type="email" name="email" required autocomplete="email" /></label>
      <label>Message<textarea name="message" rows="5" required></textarea></label>
      <button class="btn btn-primary" type="submit">Send message</button>
      <p class="status" role="status" aria-live="polite" data-status></p>
    </form>
  </div>
</section>
<script define:vars={{ email: EMAIL }}>
  // Send in the background and say what happened. If sending fails, show the address so no message is lost.
  const form = document.querySelector('[data-contact]');
  const status = form.querySelector('[data-status]');
  const btn = form.querySelector('button[type="submit"]');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = 'Sending…';
    status.className = 'status';
    status.textContent = '';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || data.success === false) throw new Error(data.message || 'Send failed');
      form.reset();
      status.classList.add('ok');
      status.textContent = "Thanks, your message is on its way. I'll reply by email.";
    } catch {
      status.classList.add('err');
      status.innerHTML = `That didn't send. Please email me directly at <a href="mailto:${email}">${email}</a>.`;
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send message';
    }
  });
</script>
<style>
  .box { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; background: var(--bg1); border: 1px solid var(--br); border-radius: 18px; padding: 44px; }
  .h2 { margin: 10px 0 12px; }
  .mail { display: inline-block; margin-top: 22px; font-size: 20px; font-weight: 800; color: var(--acc); text-decoration: none; word-break: break-all; }
  .socs { list-style: none; display: flex; gap: 18px; margin-top: 16px; }
  .socs { flex-wrap: wrap; gap: 10px; }
  .socs a { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border: 1px solid var(--br); border-radius: 999px; color: var(--dim); font-weight: 600; font-size: 15px; text-decoration: none; transition: color .2s, border-color .2s; }
  .socs a:hover { color: var(--ink); border-color: var(--acc); }
  .socs svg { width: 16px; height: 16px; fill: currentColor; flex-shrink: 0; }
  form { display: flex; flex-direction: column; gap: 16px; }
  label { display: flex; flex-direction: column; gap: 6px; font-weight: 600; font-size: 15px; }
  input, textarea { font: inherit; color: var(--ink); background: var(--bg); border: 1px solid var(--br); border-radius: 8px; padding: 12px 14px; }
  input:focus, textarea:focus { outline: 2px solid var(--acc); outline-offset: 1px; }
  button { align-self: flex-start; }
  button:disabled { opacity: .7; cursor: progress; }
  .hp { position: absolute; left: -9999px; }
  .status { font-size: 15px; font-weight: 600; min-height: 1px; }
  .status.ok { color: var(--acc); }
  .status.err { color: var(--ink); }
  .status :global(a) { color: var(--acc); }
  @media (max-width: 900px) { .box { grid-template-columns: 1fr; padding: 28px 22px; gap: 32px; } }
</style>
