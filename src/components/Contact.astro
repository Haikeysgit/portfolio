---
import { SOCIALS } from '../data/socials';
---
<section id="contact" class="wrap section">
  <div class="box">
    <div>
      <p class="label">Contact</p>
      <h2 class="h2">Get in touch</h2>
      <p class="lead">Open to full-time roles and contract work in web apps, AI agents and blockchain engineering.</p>
      <a class="mail" href="mailto:imisioluwa@obaseki.dev">imisioluwa@obaseki.dev</a>
      <ul class="socs">
        {SOCIALS.filter((s) => s.label !== 'Email').map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.path} /></svg>{s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <form action="https://formsubmit.co/imisioluwa@obaseki.dev" method="POST">
      <input type="hidden" name="_captcha" value="false" />
      <label>Your email<input type="email" name="email" required autocomplete="email" /></label>
      <label>Message<textarea name="message" rows="5" required></textarea></label>
      <button class="btn btn-primary" type="submit">Send message</button>
    </form>
  </div>
</section>
<style>
  .box { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; background: var(--bg1); border: 1px solid var(--br); border-radius: 18px; padding: 44px; }
  .h2 { margin: 10px 0 12px; }
  .mail { display: inline-block; margin-top: 22px; font-size: 20px; font-weight: 800; color: var(--acc); text-decoration: none; word-break: break-all; }
  .socs { list-style: none; display: flex; gap: 18px; margin-top: 16px; }
  .socs { flex-wrap: wrap; gap: 10px; }
  .socs a { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border: 1px solid var(--br); border-radius: 999px; color: var(--dim); font-weight: 600; font-size: 15px; text-decoration: none; transition: color .2s, border-color .2s; }
  .socs a:hover { color: var(--ink); border-color: var(--acc); }
  .socs svg { width: 16px; height: 16px; fill: currentColor; flex-shrink: 0; }
  form { display: flex; flex-direction: column; gap: 16px; }
  label { display: flex; flex-direction: column; gap: 6px; font-weight: 600; font-size: 15px; }
  input, textarea { font: inherit; color: var(--ink); background: var(--bg); border: 1px solid var(--br); border-radius: 8px; padding: 12px 14px; }
  input:focus, textarea:focus { outline: 2px solid var(--acc); outline-offset: 1px; }
  button { align-self: flex-start; }
  @media (max-width: 900px) { .box { grid-template-columns: 1fr; padding: 28px 22px; gap: 32px; } }
</style>
