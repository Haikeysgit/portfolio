---
// A themed architecture diagram: boxes joined by arrows, left to right on wide screens, top to bottom on phones.
interface Step {
  label: string;
  note?: string;
  /** Marks the parts Obaseki built. */
  mine?: boolean;
}
interface Props {
  steps: Step[];
  caption?: string;
}
const { steps, caption } = Astro.props;
const hasMine = steps.some((s) => s.mine);
---
<figure class="flow">
  <ol class="steps">
    {steps.map((s) => (
      <li class:list={["step", { mine: s.mine }]}>
        <strong>{s.label}</strong>
        {s.note && <span>{s.note}</span>}
      </li>
    ))}
  </ol>
  {(caption || hasMine) && (
    <figcaption>
      {caption}
      {hasMine && <span class="key"><i></i> Parts I built</span>}
    </figcaption>
  )}
</figure>
<style>
  .flow { margin: 28px 0; width: min(1160px, calc(100vw - 32px)); }
  .flow .steps { list-style: none; display: flex; align-items: stretch; gap: 30px; padding: 0; margin: 0; }
  .flow .step { position: relative; flex: 1; background: var(--bg1); border: 1px solid var(--br); border-radius: 12px; padding: 14px; display: flex; flex-direction: column; gap: 4px; }
  .flow .step.mine { border-color: var(--acc); background: var(--acc-bg); }
  .flow .step + .step::before { content: '→'; position: absolute; left: -24px; top: 50%; transform: translateY(-50%); color: var(--acc); font-weight: 800; }
  .flow .step strong { font-size: 15.5px; color: var(--ink); line-height: 1.3; }
  .flow .step span { font-size: 14px; color: var(--dim); line-height: 1.45; }
  figcaption { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 12px; font-size: 14px; color: var(--dim); }
  .key { display: inline-flex; align-items: center; gap: 6px; }
  .key i { width: 12px; height: 12px; border-radius: 3px; border: 1px solid var(--acc); background: var(--acc-bg); }
  @media (max-width: 767px) {
    .flow .steps { flex-direction: column; gap: 26px; }
    .flow .step + .step::before { content: '↓'; left: 50%; top: -22px; transform: translateX(-50%); }
  }
</style>
