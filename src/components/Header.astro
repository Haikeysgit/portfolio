---
import ThemeToggle from './ThemeToggle.astro';
const links = [
  { href: '/#top', label: 'Home' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#writing', label: 'Writing' },
  { href: '/#contact', label: 'Contact' },
];
const socials = [
  { href: 'https://github.com/Haikeysgit', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/imisioluwa-obaseki-537298318/', label: 'LinkedIn' },
  { href: 'https://x.com/Haikeystweett', label: 'X' },
  { href: 'mailto:imisiolwa@obaseki.dev', label: 'Email' },
];
---
<header class="hdr">
  <div class="wrap row">
    <a href="/" class="name">Obaseki</a>
    <nav aria-label="Main" class="desk-nav" data-spy-nav>
      {links.map((l) => <a href={l.href} data-spy={l.href.slice(2)}>{l.label}</a>)}
      <svg class="nav-ink" viewBox="0 0 100 14" preserveAspectRatio="none" aria-hidden="true">
        <path d="M3 9.5C18 5 30 11 46 7.5S78 4 97 8.5" />
        <path class="nav-ink-2" d="M10 12C30 9.5 55 11.5 88 10" />
      </svg>
    </nav>
    <div class="right">
      <span class="desk-only"><ThemeToggle /></span>
      <a class="btn btn-primary resume desk-only" href="/Obaseki_Resume.pdf" target="_blank" rel="noopener">Resume</a>
      <button class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mmenu" data-menu-open>
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mmenu" id="mmenu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <div class="mm-top wrap">
    <a href="/" class="name">Obaseki</a>
    <button class="mm-close" type="button" aria-label="Close menu" data-menu-close>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
  </div>

  <nav class="mm-links wrap" aria-label="Menu">
    {links.map((l, i) => (
      <a href={l.href} style={`--i:${i}`} data-menu-link data-spy={l.href.slice(2)}>
        <span class="mm-n">0{i + 1}</span>
        <span class="mm-t">{l.label}</span>
        <span class="mm-arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </nav>

  <svg class="mm-badge" viewBox="0 0 120 120" aria-hidden="true">
    <defs><path id="mm-ring" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0" /></defs>
    <text><textPath href="#mm-ring" textLength="270">FULL STACK · AI AGENTS · BLOCKCHAIN ·</textPath></text>
    <path class="mm-star" d="M60 44l4 12 12 4-12 4-4 12-4-12-12-4 12-4z" />
  </svg>

  <div class="mm-foot wrap">
    <div class="mm-actions">
      <a class="btn btn-primary" href="/Obaseki_Resume.pdf" target="_blank" rel="noopener">View resume</a>
      <ThemeToggle />
    </div>
    <ul class="mm-socials">
      {socials.map((s) => <li><a href={s.href} target={s.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{s.label}</a></li>)}
    </ul>
  </div>
</div>

<script>
  const menu = document.getElementById('mmenu')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  const close = () => {
    menu.classList.remove('is-open');
    openBtn.setAttribute('aria-expanded', 'false');
    document.documentElement.classList.remove('menu-open');
    setTimeout(() => { if (!menu.classList.contains('is-open')) menu.hidden = true; }, 350);
    openBtn.focus();
  };
  const open = () => {
    menu.hidden = false;
    requestAnimationFrame(() => menu.classList.add('is-open'));
    openBtn.setAttribute('aria-expanded', 'true');
    document.documentElement.classList.add('menu-open');
    menu.querySelector<HTMLElement>('[data-menu-link]')?.focus({ preventScroll: true });
  };
  openBtn.addEventListener('click', open);
  menu.querySelector('[data-menu-close]')!.addEventListener('click', close);
  menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', close));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu.classList.contains('is-open')) close(); });
  window.addEventListener('resize', () => { if (innerWidth >= 768 && menu.classList.contains('is-open')) close(); });

  // Where am I? A drawn caramel stroke sits under the current section and glides as you scroll.
  const nav = document.querySelector<HTMLElement>('[data-spy-nav]')!;
  const ink = nav.querySelector<SVGElement>('.nav-ink')!;
  let current = '';
  const setActive = (id: string) => {
    if (id === current) return;
    current = id;
    document.querySelectorAll<HTMLElement>('[data-spy]').forEach((a) => {
      if (a.dataset.spy === id) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    });
    const link = nav.querySelector<HTMLElement>(`[data-spy="${id}"]`);
    if (!link) { ink.classList.remove('is-on'); return; }
    ink.style.setProperty('--x', `${link.offsetLeft - 6}px`);
    ink.style.setProperty('--w', `${link.offsetWidth + 12}px`);
    ink.classList.remove('is-on');
    void ink.getBoundingClientRect();
    ink.classList.add('is-on');
  };
  const ids = ['top', 'projects', 'skills', 'writing', 'contact'];
  const sections = ids.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
  if (sections.length) {
    // On the home page: the section whose top has passed the line just under the header wins.
    const pick = () => {
      const line = 140;
      let id = 'top';
      for (const s of sections) if (s.getBoundingClientRect().top <= line) id = s.id;
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) id = sections[sections.length - 1].id;
      setActive(id);
    };
    let raf = 0;
    addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(pick); }, { passive: true });
    addEventListener('resize', () => { current = ''; pick(); });
    pick();
  } else if (location.pathname.startsWith('/projects')) {
    setActive('projects');
  }
</script>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--br); }
  .row { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px; height: 64px; }
  .name { justify-self: start; font-weight: 800; font-size: 18px; text-decoration: none; letter-spacing: -.01em; }
  .desk-nav { position: relative; display: flex; gap: clamp(32px, 4.5vw, 64px); }
  .desk-nav a { text-decoration: none; color: var(--dim); font-size: 15px; font-weight: 500; transition: color .25s; }
  .desk-nav a:hover, .desk-nav a[aria-current] { color: var(--ink); }
  .desk-nav a[aria-current] { font-weight: 700; }
  .nav-ink {
    position: absolute; left: 0; bottom: -12px; height: 12px; width: var(--w, 0); transform: translateX(var(--x, 0));
    overflow: visible; pointer-events: none; opacity: 0;
    transition: transform .55s cubic-bezier(.34, 1.3, .64, 1), width .55s cubic-bezier(.34, 1.3, .64, 1), opacity .2s;
  }
  .nav-ink.is-on { opacity: 1; }
  .nav-ink path { fill: none; stroke: var(--acc); stroke-width: 3.2; stroke-linecap: round; vector-effect: non-scaling-stroke; stroke-dasharray: 120; stroke-dashoffset: 120; }
  .nav-ink .nav-ink-2 { stroke-width: 1.8; opacity: .55; }
  .nav-ink.is-on path { animation: ink-draw .6s .15s cubic-bezier(.6, .1, .3, 1) forwards; }
  .nav-ink.is-on .nav-ink-2 { animation-delay: .32s; }
  @keyframes ink-draw { to { stroke-dashoffset: 0; } }
  .right { justify-self: end; display: flex; gap: 10px; align-items: center; }
  .resume { padding: 9px 16px; font-size: 14px; }
  .menu-btn { display: none; }

  @media (max-width: 767px) {
    .row { grid-template-columns: 1fr auto; }
    .desk-nav, .desk-only { display: none !important; }
    .menu-btn { display: grid; gap: 6px; place-content: center; width: 44px; height: 44px; border-radius: 12px; border: 1px solid var(--br); background: var(--bg1); cursor: pointer; }
    .menu-btn span { display: block; width: 20px; height: 2px; border-radius: 2px; background: var(--ink); transition: transform .3s; }
    .menu-btn span:last-child { width: 13px; justify-self: end; }
    .menu-btn:hover span:last-child { transform: translateX(-7px); }
  }

  /* Full-screen phone menu */
  .mmenu {
    position: fixed; inset: 0; z-index: 80; display: flex; flex-direction: column; overflow-y: auto;
    background: radial-gradient(120% 70% at 100% 100%, color-mix(in srgb, var(--acc) 22%, var(--bg)) 0%, var(--bg) 60%);
    clip-path: circle(0% at calc(100% - 38px) 32px); transition: clip-path .55s cubic-bezier(.7, 0, .2, 1);
  }
  .mmenu.is-open { clip-path: circle(150% at calc(100% - 38px) 32px); }
  .mmenu[hidden] { display: none; }
  :global(html.menu-open) { overflow: hidden; }
  .mm-top { display: flex; justify-content: space-between; align-items: center; height: 64px; flex-shrink: 0; }
  .mm-close { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; border: 1px solid var(--br); background: var(--bg1); color: var(--ink); cursor: pointer; }
  .mm-close svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }

  .mm-links { display: grid; margin-top: 4vh; }
  .mm-links a {
    display: grid; grid-template-columns: 44px 1fr auto; align-items: baseline; gap: 6px; padding: 14px 0; border-bottom: 1px solid var(--br);
    text-decoration: none; opacity: 0; transform: translateX(28px);
    transition: opacity .45s ease, transform .55s cubic-bezier(.16, 1, .3, 1), color .2s; transition-delay: calc(.12s + var(--i) * 60ms);
  }
  .mmenu.is-open .mm-links a { opacity: 1; transform: none; }
  .mm-n { font-family: var(--mono); font-size: 13px; color: var(--acc); }
  .mm-t { font-size: clamp(30px, 9vw, 40px); font-weight: 800; letter-spacing: -.03em; line-height: 1.1; }
  .mm-arrow { font-size: 22px; color: var(--dim); transition: transform .3s cubic-bezier(.34, 1.56, .64, 1), color .2s; }
  .mm-links a:hover .mm-arrow, .mm-links a:focus-visible .mm-arrow { transform: translateX(6px); color: var(--acc); }
  .mm-links a:active .mm-t, .mm-links a[aria-current] .mm-t { color: var(--acc); }
  .mm-links a[aria-current] .mm-arrow { color: var(--acc); }

  .mm-badge { position: absolute; right: 18px; bottom: 150px; width: 104px; height: 104px; fill: var(--acc); animation: mm-spin 16s linear infinite; opacity: .85; pointer-events: none; }
  .mm-badge text { font-family: var(--mono); font-size: 9.5px; letter-spacing: .12em; }
  .mm-star { fill: var(--ink); transform-origin: 60px 60px; animation: mm-spin 16s linear infinite reverse; }
  @keyframes mm-spin { to { transform: rotate(360deg); } }

  .mm-foot { margin-top: auto; padding-top: 28px; padding-bottom: 28px; display: grid; gap: 18px; opacity: 0; transition: opacity .5s .45s; }
  .mmenu.is-open .mm-foot { opacity: 1; }
  .mm-actions { display: flex; gap: 10px; align-items: center; }
  .mm-actions .btn { flex: 1; justify-content: center; }
  .mm-socials { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .mm-socials a { display: inline-block; padding: 8px 14px; border: 1px solid var(--br); border-radius: 999px; text-decoration: none; font-weight: 600; font-size: 14px; color: var(--dim); }
  .mm-socials a:hover { color: var(--ink); border-color: var(--acc); }
  @media (prefers-reduced-motion: reduce) {
    .nav-ink { transition: none; }
    .nav-ink.is-on path { animation: none; stroke-dashoffset: 0; }
    .mmenu, .mm-links a, .mm-foot { transition: none; }
    .mm-badge, .mm-star { animation: none; }
  }
</style>
