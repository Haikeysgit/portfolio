---
import type { CollectionEntry } from 'astro:content';
import DeviceFrame from './DeviceFrame.astro';
import Gallery from './Gallery.astro';
import DemoHost from '../demos/DemoHost';

interface Props {
  project: CollectionEntry<'projects'>;
}
const p = Astro.props.project.data;
// Demos that exist so far. A project whose demo is not built yet falls back to its screenshots.
const built = ['squadjar', 'kedge', 'hsbyfiona', 'bulkhead'];
const hasDemo = p.demo !== undefined && built.includes(p.demo);
const extra =
  p.demo === 'kedge' ? 'The runs it replays are real.'
  : p.demo === 'bulkhead' ? 'The project itself is still in development.'
  : 'No real money moves.';
---
{hasDemo ? (
  <div class="demo" data-haptic>
    <div class="note">
      <p class="label">Interactive demo</p>
      <p class="note-t">
        A small demo to give you a feel for {p.name}. It's not an exact copy of the app, so feel free to click around.
        {extra}
      </p>
    </div>
    <DeviceFrame kind="auto">
      {p.demo && <DemoHost demo={p.demo} client:visible />}
    </DeviceFrame>
  </div>
) : (
  <Gallery shots={p.shots} />
)}
<style>
  .note { text-align: center; margin: 0 auto 18px; max-width: 620px; display: grid; gap: 6px; }
  .note-t { color: var(--dim); font-size: 15.5px; line-height: 1.55; margin: 0; }
</style>
