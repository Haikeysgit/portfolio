---
import { highlights } from '../data/highlights';
---
<section class="hero wrap" id="top">
  <div class="intro">
    <h1>Full stack &amp; blockchain engineer.</h1>
    <div class="copy">
      <p>I build web apps, AI agents and smart contracts.</p>
      <p>Web apps that are easy to use and hard to break. AI agents that run on their own, start to finish.</p>
      <p>And Solidity contracts on Ethereum, Base and other EVM chains, reviewed for security and fuzz-tested before they touch a cent.</p>
    </div>
    <div class="ctas">
      <a class="btn btn-primary" href="#projects">See projects</a>
      <span class="resume">
        <a class="btn resume-view" href="/Obaseki_Resume.pdf" target="_blank" rel="noopener">View resume</a>
        <a class="btn resume-dl" href="/Obaseki_Resume.pdf" download="Obaseki_Resume.pdf" aria-label="Download resume (PDF)" title="Download resume (PDF)">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11" /><path d="m7 11 5 5 5-5" /><path d="M5 20h14" /></svg>
        </a>
      </span>
      <a class="btn" href="#contact">Contact</a>
    </div>
  </div>

  <div class="stage">
    <div class="glow" aria-hidden="true"></div>
    <figure class="portrait">
      <img
        src="/images/me/portrait-900.webp"
        srcset="/images/me/portrait-480.webp 480w, /images/me/portrait-900.webp 900w"
        sizes="(max-width: 900px) 70vw, 420px"
        alt="Obaseki, smiling, in a camel suit and dark tie"
        width="900"
        height="900"
        fetchpriority="high"
      />
    </figure>
    {highlights.map((h, i) => (
      <a class={`fact fact-${i + 1}`} href={`/projects/${h.slug}`} style={`--d:${i * 0.9}s`}>
        <span class="track">{h.track}</span>
        <strong>{h.fact}</strong>
        <span class="note">{h.note}</span>
      </a>
    ))}
  </div>
</section>
<style>
  .hero { display: grid; grid-template-columns: 1.05fr 1fr; gap: 48px; align-items: center; padding: 20px 0 56px; }
  h1 { font-size: clamp(38px, 5.4vw, 64px); font-weight: 800; line-height: 1.04; letter-spacing: -.03em; margin: 0; }
  .copy { display: grid; gap: 14px; margin-top: 22px; max-width: 540px; }
  .copy p { color: var(--dim); font-size: 17.5px; line-height: 1.6; }
  .copy p:first-child { color: var(--ink); font-weight: 600; }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }

  /* View resume + download, joined like one control. */
  .resume { display: inline-flex; }
  .resume-view { border-radius: 8px 0 0 8px; }
  .resume-dl { border-radius: 0 8px 8px 0; margin-left: -1px; padding: 12px 14px; }
  .resume-dl svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .resume-dl:hover svg { animation: dip .7s cubic-bezier(.34, 1.56, .64, 1); }
  @keyframes dip { 0% { transform: none; } 45% { transform: translateY(3px); } 100% { transform: none; } }

  /* Portrait with facts floating around it. */
  .stage { position: relative; justify-self: center; width: min(100%, 460px); aspect-ratio: 1 / 1.08; }
  .glow { position: absolute; inset: 6% 4% 0; border-radius: 50%; background: radial-gradient(circle at 50% 45%, var(--acc) 0%, transparent 65%); opacity: .35; filter: blur(30px); }
  .portrait { position: absolute; inset: 0 12%; margin: 0; border-radius: 999px 999px 28px 28px; overflow: hidden; border: 1px solid var(--br); box-shadow: var(--shadow); background: var(--bg2); }
  .portrait img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; }

  .fact {
    position: absolute; z-index: 2; display: grid; gap: 2px; max-width: 220px; padding: 12px 14px; border-radius: 14px; text-decoration: none;
    background: color-mix(in srgb, var(--bg1) 88%, transparent); backdrop-filter: blur(10px); border: 1px solid var(--br); box-shadow: var(--shadow);
    animation: float 6s ease-in-out var(--d) infinite; transition: border-color .2s, transform .25s;
  }
  .fact:hover { border-color: var(--acc); animation-play-state: paused; }
  .fact strong { font-size: 16px; font-weight: 800; line-height: 1.2; color: var(--ink); }
  .fact .note { font-size: 13px; color: var(--dim); }
  .fact .track { justify-self: start; font-size: 11px; padding: 2px 8px; }
  .fact-1 { top: 8%; left: -6%; }
  .fact-2 { top: 42%; right: -8%; }
  .fact-3 { bottom: 6%; left: -2%; }
  @keyframes float { 0%, 100% { transform: translateY(0) rotate(-.6deg); } 50% { transform: translateY(-10px) rotate(.6deg); } }

  /* Small laptops: keep the floating cards inside the screen. */
  @media (max-width: 1180px) {
    .fact-1 { left: -2%; }
    .fact-2 { right: -2%; }
  }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 48px; padding: 28px 0 40px; }
    .stage { width: min(100%, 420px); }
  }
  /* Phones: the same words, with room to breathe between every block. */
  @media (max-width: 600px) {
    .hero { gap: 56px; padding: 44px 0 24px; }
    h1 { font-size: 34px; line-height: 1.08; }
    .copy { gap: 18px; margin-top: 30px; }
    .copy p { font-size: 16px; line-height: 1.65; }
    .ctas { flex-wrap: nowrap; gap: 8px; margin-top: 36px; }
    .ctas > .btn, .resume { flex: 1 1 auto; }
    .ctas .btn { justify-content: center; padding: 11px 10px; font-size: 13.5px; border-radius: 8px; white-space: nowrap; }
    .resume-view { flex: 1 1 auto; border-radius: 8px 0 0 8px !important; }
    .resume-dl { border-radius: 0 8px 8px 0 !important; padding: 11px 10px !important; }
    .resume-dl svg { width: 15px; height: 15px; }

    /* Photo and floating fun facts, sized for phones. */
    .stage { aspect-ratio: 1 / 1.12; }
    .portrait { inset: 2% 16% 0; }
    .fact { max-width: 168px; padding: 9px 11px; border-radius: 12px; }
    .fact strong { font-size: 14px; }
    .fact .note { display: none; }
    .fact .track { font-size: 10px; }
    .fact-1 { top: 6%; left: 0; }
    .fact-2 { top: 44%; right: 0; }
    .fact-3 { bottom: 4%; left: 2%; }
  }
  @media (max-width: 339px) { .ctas { flex-wrap: wrap; } }
  @media (prefers-reduced-motion: reduce) { .fact { animation: none; } }
</style>
